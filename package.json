{
  "name": "@dldkhy/opencode-voice",
  "version": "1.0.0",
  "description": "Speech-to-text and text-to-speech for OpenCode V2. Record voice prompts with whisper-cpp, hear responses via Piper TTS, with LLM normalization through any OpenAI-compatible endpoint.",
  "keywords": [
    "opencode",
    "piper",
    "plugin",
    "speech-to-text",
    "stt",
    "text-to-speech",
    "tts",
    "voice",
    "whisper"
  ],
  "homepage": "https://github.com/dldkhy/opencode-voice#readme",
  "bugs": {
    "url": "https://github.com/dldkhy/opencode-voice/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jesse Chen"
  },
  "contributors": [
    {
      "name": "Soner Koksal",
      "url": "https://github.com/renjfk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dldkhy/opencode-voice.git"
  },
  "files": [
    "index.js",
    "tui.js",
    "lib"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./tui": {
      "import": "./index.js"
    }
  },
  "scripts": {
    "lint": "npx oxlint .",
    "fmt": "npx oxfmt --check .",
    "fmt:fix": "npx oxfmt --write .",
    "test": "node --test",
    "check": "npm run lint && npm run fmt",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0"
  }
}
